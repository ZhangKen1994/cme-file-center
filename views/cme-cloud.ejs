<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CME 文件后台</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page-shell">
      <nav class="topbar">
        <div>
          <strong>当前账号：</strong>
          <span><%= currentUser.username %></span>
          <span class="badge <%= currentUser.role === 'admin' ? 'active' : 'neutral' %>"><%= currentUser.role %></span>
        </div>
        <form action="/logout" method="post">
          <button type="submit">退出登录</button>
        </form>
      </nav>

      <header class="hero">
        <div>
          <p class="eyebrow">CME File Center</p>
          <h1>CME 文件后台</h1>
          <p class="hero-copy">云端版本只保留 CME 文件下载、归档和历史记录。</p>
        </div>
        <div class="hero-card">
          <div class="stat">
            <span>已归档文件</span>
            <strong><%= cmeDashboard.stats.totalFiles %></strong>
          </div>
          <div class="stat">
            <span>黄金文件</span>
            <strong><%= cmeDashboard.stats.goldFiles %></strong>
          </div>
          <div class="stat">
            <span>白银文件</span>
            <strong><%= cmeDashboard.stats.silverFiles %></strong>
          </div>
        </div>
      </header>

      <% if (flash) { %>
        <div class="notice success"><%= flash %></div>
      <% } %>
      <% if (error) { %>
        <div class="notice error"><%= error %></div>
      <% } %>

      <main class="stack">
        <section class="panel">
          <div class="panel-head panel-head-split">
            <div>
              <h2>文件状态</h2>
              <p>系统会自动检查黄金和白银文件，并只保存符合条件的版本。</p>
            </div>
            <form action="/run" method="post">
              <button type="submit" class="primary-btn">立即检查一次</button>
            </form>
          </div>
        </section>

        <% cmeDashboard.fileGroups.forEach((group) => { %>
          <section class="panel">
            <div class="panel-head">
              <h2><%= group.label %></h2>
              <p>这个分类下会保留已经归档的历史文件。</p>
            </div>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>交易日期</th>
                    <th>报告日期</th>
                    <th>文件名</th>
                    <th>大小</th>
                    <th>入库时间</th>
                    <th>操作</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!group.files.length) { %>
                    <tr>
                      <td colspan="7" class="empty">还没有归档文件。</td>
                    </tr>
                  <% } %>
                  <% group.files.forEach((file) => { %>
                    <tr>
                      <td><%= file.id %></td>
                      <td><strong><%= file.activity_date || "-" %></strong></td>
                      <td><%= file.report_date || "-" %></td>
                      <td><%= file.stored_filename %></td>
                      <td><%= file.file_size_bytes ? Math.round(file.file_size_bytes / 1024) + " KB" : "-" %></td>
                      <td><%= formatDateTime(file.created_at) %></td>
                      <td>
                        <a class="link-btn" href="/files/<%= file.id %>/download">下载文件</a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </section>
        <% }) %>

      </main>
    </div>
  </body>
  </html>
